# Preserve LF for files consumed by sha256sum -c and bash scripts on CI runners.
reproducibility/MANIFEST.sha256 text eol=lf
us/baselines/run_all_baselines.sh text eol=lf
.github/workflows/*.yml text eol=lf

# Shipped data CSVs are hashed (reproducibility/MANIFEST.sha256). Pin to LF so
# that Windows contributors with core.autocrlf=true do not silently rewrite them
# to CRLF, which would break the CI manifest and verification checks.
*.csv text eol=lf
